{
  "name": "@cornertasks/web",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "description": "CornerTasks web app (mobile-first). Local-only by default; cloud sync is opt-in (added in later iterations).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
