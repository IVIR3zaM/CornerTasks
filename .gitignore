# Swift / SPM
.build/
.swiftpm/
Package.resolved
*.xcodeproj/

# macOS
.DS_Store

# vscode & claude code
.vscode/

# Claude Code: local settings stay local, but skills and agent definitions are
# part of the repo — a cloud or CI session clones the repo and would otherwise
# have neither. Keep `settings.local.json` (machine-specific permissions) out.
.claude/*
!.claude/skills/
!.claude/agents/

# Build artifacts (apps/macos/build.sh runs from apps/macos/)
apps/macos/CornerTasks.app/
apps/macos/CornerTasks.iconset/
apps/macos/CornerTasks.icns
apps/macos/dmg/

# Release output (DMG is generated, don't commit)
apps/macos/release/*.dmg

node_modules/

# Generated by `make design-preview` / CI. Reproducible from design/ sources.
design/preview/

# Personal scratch: mnemonic.txt, DID dumps, migration backups, ad-hoc helpers.
# Treat the whole folder as local-only — never committed.
test/