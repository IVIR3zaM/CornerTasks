{
  "$schema": "../schema/component.schema.json",
  "name": "Select",
  "description": "Single-choice dropdown.",
  "props": {
    "labelKey":     { "type": "textKey", "required": false },
    "valueBinding": { "type": "string",  "required": true },
    "options": {
      "type": "array",
      "required": true,
      "of": {
        "value":    { "type": "string", "required": true },
        "labelKey": { "type": "textKey", "required": true }
      }
    }
  },
  "children": "none",
  "a11y": { "role": "combobox", "labelFrom": "labelKey" }
}
